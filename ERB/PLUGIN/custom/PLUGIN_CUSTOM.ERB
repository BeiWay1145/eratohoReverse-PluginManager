GOTO EXP_LOOP

;──────────────────────────────
;经验数值输入（ARG=菜单编号 1-11，映射到 EXP 槽位）
;──────────────────────────────
@PLUGIN_CUSTOM_EXP_INPUT, ARG
#DIM LOCAL_EXPSLOT
#DIM LOCAL_IN
;菜单编号 → EXP 槽位
SELECTCASE ARG
	CASE 1
		LOCAL_EXPSLOT = 0
	CASE 2
		LOCAL_EXPSLOT = 1
	CASE 3
		LOCAL_EXPSLOT = 2
	CASE 4
		LOCAL_EXPSLOT = 3
	CASE 5
		LOCAL_EXPSLOT = 4
	CASE 6
		LOCAL_EXPSLOT = 5
	CASE 7
		LOCAL_EXPSLOT = 6
	CASE 8
		LOCAL_EXPSLOT = 7
	CASE 9
		LOCAL_EXPSLOT = 8
	CASE 10
		LOCAL_EXPSLOT = 10
	CASE 11
		LOCAL_EXPSLOT = 20
ENDSELECT
PRINTFORML 输入数值（当前 {EXP:MASTER:LOCAL_EXPSLOT}，0-999，[0] 清零）
$EXP_INPUT
INPUT
IF RESULT < 0 || RESULT > 999
	CLEARLINE 1
	REUSELASTLINE ※数值需在 0-999 之间
	GOTO EXP_INPUT
ENDIF
EXP:MASTER:LOCAL_EXPSLOT = RESULT
RETURN 0

;──────────────────────────────
;保存槽位选择界面
;  返回：RESULT = 槽位号（0-4），-1 = 取消
;──────────────────────────────
@PLUGIN_CUSTOM_SLOTSELECT
#DIM LOCAL_I
#DIM LOCAL_IN
#DIMS LOCAL_TMP
PRINTL ──── 选择保存槽位 ────
FOR LOCAL_I, 0, 5
	IF GLOBALS:LOCAL_I == ""
		PRINTFORML [{LOCAL_I}] ＥＭＰＴＹ
	ELSE
		LOCAL_TMP = %GLOBALS:LOCAL_I%
		PRINTFORML [{LOCAL_I}] 有数据
	ENDIF
NEXT
PRINTL [99] 取消
INPUT
IF RESULT == 99
	RETURN -1
ELSEIF RANGE(RESULT, 0, 4)
	RETURN RESULT
ELSE
	PRINTFORML (custom) 输入值超出范围
	RETURN -1
ENDIF
