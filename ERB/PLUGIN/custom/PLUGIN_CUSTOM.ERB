;══════════════════════════════════════════════════════════
;自定义角色制作插件（custom）
;  在 NORMAL 模式角色菜单 [0]制作角色 [1]加载角色 同级增加 [2]自定义角色制作
;  自由设定：姓名 / 性别（男·女·扶她）/ 性格 / 性质 / 经验
;  制作结果保存到 GLOBALS:0-4 槽位，可被 [1]加载角色 正常读取
;
;  钩子函数：
;    @PLUGIN_custom_CHARAMAKE_MENU    在 [0][1] 菜单后打印 [2] 选项
;    @PLUGIN_custom_CHARAMAKE_SELECT  玩家选 [2] 后进入自定义制作流程
;══════════════════════════════════════════════════════════

;──────────────────────────────
;CHARAMAKE 菜单钩子：打印 [2] 选项
;──────────────────────────────
@PLUGIN_custom_CHARAMAKE_MENU
PRINTFORMDL [2]自定义角色制作
RETURN 0

;──────────────────────────────
;CHARAMAKE_SELECT 钩子：玩家选 [2] 后进入自定义制作
;  完成后 RETURN，主流程回到 $MAKE_OR_LORD 菜单
;──────────────────────────────
@PLUGIN_custom_CHARAMAKE_SELECT
CALL PLUGIN_CUSTOM_EDITOR
RETURN 0

;──────────────────────────────
;自定义角色制作编辑器（主流程）
;  选槽位 → 清空 MASTER 角色数据 → 属性编辑循环 → 保存
;──────────────────────────────
@PLUGIN_CUSTOM_EDITOR
#DIM LOCAL_LINE
#DIM LOCAL_SLOT
#DIM LOCAL_IN
#DIMS LOCAL_SEXSTR
CALL PLUGIN_CUSTOM_SLOTSELECT
SIF RESULT < 0
	RETURN 0
LOCAL_SLOT = RESULT
;从空白开始自定义：清空 0 号角色（MASTER）的 TALENT/EXP/ABL
CALL PLUGIN_CUSTOM_CLEAR
;主编辑循环
$EDIT_LOOP
CLEARLINE LINECOUNT - LOCAL_LINE
LOCAL_LINE = LINECOUNT
PRINTL ──── 自定义角色制作 ────
IF TALENT:MASTER:男性
	LOCAL_SEXSTR = 男性
ELSEIF TALENT:MASTER:扶她
	LOCAL_SEXSTR = 扶她
ELSE
	LOCAL_SEXSTR = 女性
ENDIF
PRINTFORML [1] 姓名　当前：%NAME:MASTER%（称呼：%CALLNAME:MASTER%）
PRINTFORML [2] 性别　当前：%LOCAL_SEXSTR%
PRINTFORML [3] 性格　（自尊心/胆怯/刚毅/贞操观念等）
PRINTFORML [4] 性质　（处女/童贞/妊娠/母性）
PRINTFORML [5] 经验　（ＣＶＡＢ经验/绝顶経験/射精経験等）
PRINTL 
PRINTL [0] 完成并保存
PRINTL [99] 取消（不保存）
INPUT
LOCAL_IN = RESULT
IF LOCAL_IN == 1
	CALL PLUGIN_CUSTOM_NAME
ELSEIF LOCAL_IN == 2
	CALL PLUGIN_CUSTOM_SEX
ELSEIF LOCAL_IN == 3
	CALL PLUGIN_CUSTOM_TALENT
ELSEIF LOCAL_IN == 4
	CALL PLUGIN_CUSTOM_STATE
ELSEIF LOCAL_IN == 5
	CALL PLUGIN_CUSTOM_EXP
ELSEIF LOCAL_IN == 0
	PRINTFORML 确定保存到槽位 [{LOCAL_SLOT}] 并覆写吗？
	PRINTL [0] 是
	PRINTL [1] 否
	INPUT
	IF RESULT == 0
		;先按性格算 MAXBASE，再复用本体 CHARAMAKE_SAVE 存到槽位
		CALL BASE_MASTER_SETUP
		CALL CHARAMAKE_SAVE, LOCAL_SLOT, MASTER
		PRINTFORML (custom) 已保存到槽位 [{LOCAL_SLOT}]
		INPUT
		RETURN 0
	ENDIF
ELSEIF LOCAL_IN == 99
	PRINTL 确定取消制作吗？未保存的数据将丢失
	PRINTL [0] 是
	PRINTL [1] 否
	INPUT
	SIF RESULT == 0
		RETURN 0
ENDIF
GOTO EDIT_LOOP

;──────────────────────────────
;清空 0 号角色（MASTER）的 TALENT/EXP/ABL，重置名字
;──────────────────────────────
@PLUGIN_CUSTOM_CLEAR
#DIM LOCAL_I
FOR LOCAL_I, 0, VARSIZE("TALENT")
	TALENT:MASTER:LOCAL_I = 0
NEXT
FOR LOCAL_I, 0, VARSIZE("EXP")
	EXP:MASTER:LOCAL_I = 0
NEXT
FOR LOCAL_I, 0, VARSIZE("ABL")
	ABL:MASTER:LOCAL_I = 0
NEXT
NAME:MASTER = 您
CALLNAME:MASTER = 您
RETURN 0

;──────────────────────────────
;姓名设定
;──────────────────────────────
@PLUGIN_CUSTOM_NAME
#DIM LOCAL_IN
#DIMS LOCAL_TMP
PRINTL ──── 姓名设定 ────
PRINTL 输入名字（16字以内）
$NAME_INPUT
INPUTS
IF STRLENS(RESULTS) > 16
	CLEARLINE 1
	REUSELASTLINE ※名字过长，请重新输入
	GOTO NAME_INPUT
ELSEIF RESULTS == ""
	CLEARLINE 1
	REUSELASTLINE ※请勿留空，输入 [0] 则使用「您」
	GOTO NAME_INPUT
ELSEIF RESULTS == "0"
	NAME:MASTER = 您
	CALLNAME:MASTER = 您
	RETURN 0
ELSE
	NAME:MASTER = %RESULTS%
ENDIF
PRINTL 输入称呼（12字以内）
$CALLNAME_INPUT
INPUTS
IF STRLENS(RESULTS) > 12
	CLEARLINE 1
	REUSELASTLINE ※称呼过长，请重新输入
	GOTO CALLNAME_INPUT
ELSEIF RESULTS == ""
	CLEARLINE 1
	REUSELASTLINE ※请勿留空
	GOTO CALLNAME_INPUT
ELSEIF RESULTS == "0"
	CALLNAME:MASTER = %NAME:MASTER%
	RETURN 0
ELSE
	CALLNAME:MASTER = %RESULTS%
ENDIF
PRINTFORML (custom) 已设定：%NAME:MASTER%（%CALLNAME:MASTER%）
RETURN 0

;──────────────────────────────
;性别设定（男/女/扶她 互斥）
;──────────────────────────────
@PLUGIN_CUSTOM_SEX
#DIM LOCAL_IN
PRINTL ──── 性别设定 ────
PRINTL [0] 男性
PRINTL [1] 女性
PRINTL [2] 扶她
PRINTL [99] 返回
INPUT
LOCAL_IN = RESULT
IF LOCAL_IN == 0
	TALENT:MASTER:男性 = 1
	TALENT:MASTER:扶她 = 0
ELSEIF LOCAL_IN == 1
	TALENT:MASTER:男性 = 0
	TALENT:MASTER:扶她 = 0
ELSEIF LOCAL_IN == 2
	TALENT:MASTER:男性 = 0
	TALENT:MASTER:扶她 = 1
ENDIF
RETURN 0

;──────────────────────────────
